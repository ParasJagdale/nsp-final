# Backend server
PORT=5174
NODE_ENV=development

# MongoDB Atlas connection string
# Example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nsp?retryWrites=true&w=majority&appName=<app>
MONGODB_URI=

# Cookie signing / JWT secret
JWT_SECRET=replace-with-a-long-random-string

# CORS / front-end origin
FRONTEND_ORIGIN=http://localhost:5173

# SMTP (for sending OTP emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="National Scholarship Portal <no-reply@example.com>"
